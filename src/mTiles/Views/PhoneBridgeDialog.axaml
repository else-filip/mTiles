<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:mTiles.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="mTiles.Views.PhoneBridgeDialog"
             x:DataType="vm:PhoneBridgeViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="{DynamicResource FontXs}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <!-- The card is OverlayHost's; this draws only its own content. -->
    <Border Padding="20,4,20,16">
        <DockPanel>

            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Spacing="3">
                <TextBlock Text="Pair a phone"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontLg}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding Status}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="{DynamicResource FontSm}"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Footer -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left"
                        Classes="outlined-sm on-elevated"
                        Content="New code"
                        ToolTip.Tip="Withdraw this code and show a fresh one"
                        Command="{Binding RenewCommand}" />
                <Button x:Name="CloseButton"
                        Classes="accent"
                        HorizontalAlignment="Right"
                        Content="Done"
                        MinWidth="80" Padding="12,5" MinHeight="0"
                        FontSize="{DynamicResource FontSm}"
                        Cursor="Hand"
                        Click="Close_Click" />
            </DockPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
                <StackPanel Spacing="14">

                    <ProgressBar IsIndeterminate="True" Height="2"
                                 IsVisible="{Binding IsBusy}" />

                    <Border IsVisible="{Binding HasError}"
                            Background="{DynamicResource DangerSubtle}"
                            CornerRadius="{DynamicResource RadiusMd}"
                            Padding="12,10">
                        <TextBlock Text="{Binding Error}"
                                   Foreground="{DynamicResource DangerText}"
                                   FontSize="{DynamicResource FontSm}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- The code. A DockPanel so the code keeps its natural size and the words take what
                         is left. Interpolation off: a QR code is a grid of hard pixels, and smoothing it is
                         what makes a small one fail to scan. -->
                    <DockPanel IsVisible="{Binding HasCode}">
                        <Border DockPanel.Dock="Left"
                                Background="White"
                                Padding="8"
                                CornerRadius="{DynamicResource RadiusSm}"
                                VerticalAlignment="Top">
                            <Image Source="{Binding QrImage}"
                                   Width="232" Height="232"
                                   RenderOptions.BitmapInterpolationMode="None" />
                        </Border>

                        <StackPanel Spacing="10" Margin="18,2,0,0" VerticalAlignment="Top">
                            <TextBlock Text="Point your phone's camera at the code and open the page it offers. It pairs once; afterwards the phone reconnects on its own, from any network."
                                       FontSize="{DynamicResource FontSm}"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="From the phone you can see every workspace, zoom into a tile, follow an agent's or a goal's conversation as it happens, answer what it asks, type or dictate into it, and press its keys and actions."
                                       Classes="note" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="TimerSandComplete" Width="13" Height="13"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ExpiresText}" Classes="note" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Classes="outlined-sm"
                                    HorizontalAlignment="Left"
                                    Content="Copy link"
                                    Command="{Binding CopyLinkCommand}"
                                    ToolTip.Tip="For a browser on this computer, or to send to yourself" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Paired devices -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasDevices}">
                        <TextBlock Text="PAIRED" Classes="section" Margin="0" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PhoneDeviceViewModel">
                                    <Border Background="{DynamicResource BgElevated}"
                                            CornerRadius="{DynamicResource RadiusRow}"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right"
                                                    Classes="outlined-sm on-elevated"
                                                    Content="Unpair"
                                                    ToolTip.Tip="Forget this device. It cannot reconnect without a new code."
                                                    Command="{Binding UnpairCommand}" />
                                            <mi:MaterialIcon Kind="Cellphone" Width="16" Height="16"
                                                             Margin="0,0,8,0"
                                                             Foreground="{DynamicResource TextSecondary}"
                                                             VerticalAlignment="Center" />
                                            <mi:MaterialIcon DockPanel.Dock="Left" Kind="Circle" Width="7" Height="7"
                                                             Margin="0,0,8,0"
                                                             IsVisible="{Binding IsConnected}"
                                                             Foreground="{DynamicResource StatusSuccessText}"
                                                             VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="{DynamicResource FontSm}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Since}" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       FontSize="{DynamicResource FontXs}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Classes="note"
                               Text="No port is opened on this computer. The phone and mTiles both connect out to Tailscale's public relays, which pass on end-to-end encrypted bytes they cannot read. A paired phone can type into your terminals, so unpair a device you no longer use." />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
